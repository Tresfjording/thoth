# Protect the Thoth application and all files below this directory.
# Create this file on the server; never commit it to the repository.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://www.tresfjording.no%{REQUEST_URI} [R=301,L]
</IfModule>

AuthType Basic
AuthName "Thoth"
AuthUserFile "/customers/e/1/5/c6ksomeyl/webroots/www/thoth/.htpasswd"

# Deny obvious scraper and scanner bots while allowing normal visitors and search engines.
SetEnvIfNoCase User-Agent "^$" BadBot
SetEnvIfNoCase User-Agent "^-" BadBot
SetEnvIfNoCase User-Agent "(curl|wget|python-requests|python-urllib|libwww-perl|scrapy|aiohttp|httpx|Go-http-client|java/|nmap|nikto|sqlmap|masscan|sqlninja|havij|acunetix|nessus|zgrab|httpie|metasploit|paloaltonetworks|semrush|ahrefs|mj12bot|petalbot|dotbot|sitechecker|siteliner|dataforseo)" BadBot

<IfModule mod_authz_core.c>
    <RequireAll>
        Require valid-user
        Require not env BadBot
    </RequireAll>
</IfModule>

# The published reading page is intentionally public.
<FilesMatch "^lese\.html$">
    Require all granted
</FilesMatch>

# If your host is on Apache 2.2 instead of 2.4, you can use this alternative instead:
# Order allow,deny
# AuthType Basic
# AuthName "Thoth"
# AuthUserFile "/customers/e/1/5/c6ksomeyl/webroots/www/thoth/.htpasswd"
# Require valid-user
# Deny from env=BadBot
